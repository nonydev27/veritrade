PORT=5000

# Local dev: uses backend/local_data/*.json (no Postgres required).
# For Postgres, replace with your real connection string.
DATABASE_URL=postgresql://user:pass@localhost:5432/veritrade_db

JWT_SECRET=your-super-secret-jwt-key-change-this

# Moolre API (use sandbox keys for testing)
MOOLRE_API_KEY=your_moolre_sandbox_key
MOOLRE_API_SECRET=your_moolre_sandbox_secret
MOOLRE_WEBHOOK_SECRET=your_webhook_secret
MOOLRE_API_URL=https://sandbox.moolre.com/v1
MOOLRE_URL=https://api.moolre.com/v1
APP_BASE_URL=https://your-backend.railway.app
CORS_ORIGIN=*
