# Copy to .env and set your machine's LAN IP (same Wi‑Fi as your phone).
# Expo tunnel mode only tunnels Metro — API requests go directly to this URL.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000/api

# VeriBot AI — set ONE of these (OpenRouter recommended, affordable)
EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-key-here
# EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-key-here
